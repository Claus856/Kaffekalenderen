{
  "name": "kaffekalenderen",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Kaffekalenderen – vennegruppens karakterbog for BREW Companys kaffejulekalender",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:rls": "vitest run supabase/tests",
    "scrape": "tsx scripts/scrape-coffees.ts",
    "scrape:dry": "tsx scripts/scrape-coffees.ts --dry-run",
    "icons": "tsx scripts/make-icons.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "postbuild": "tsx scripts/check-secrets.ts dist",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "smoke:ratings": "tsx scripts/smoke-ratings.ts",
    "smoke:reset": "tsx scripts/smoke-reset.ts",
    "e2e": "tsx scripts/e2e-fixture.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "postcss": "^8.4.41",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
