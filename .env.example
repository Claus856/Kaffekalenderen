# Kopiér til .env og udfyld. .env er i .gitignore og må aldrig committes.

# ── Frontend (offentlige værdier, bundles ind i appen) ──────────────────────
# Supabase → Project Settings → API
# Nøglen hedder "Publishable key" (sb_publishable_…) i nye projekter, eller "anon" i ældre.
VITE_SUPABASE_URL=https://<dit-projekt>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable/anon-nøglen>

# ── Kun til lokale scripts (scraperen) ──────────────────────────────────────
# Bevidst UDEN VITE_-præfiks, så Vite aldrig kan bundle den ind i frontend.
# Service-role-nøglen omgår RLS. Hold den hemmelig, og sæt den ALDRIG i Netlify.
SUPABASE_URL=https://<dit-projekt>.supabase.co
# "Secret key" (sb_secret_…) i nye projekter, eller "service_role" i ældre.
SUPABASE_SERVICE_ROLE_KEY=<secret/service_role-nøglen>
