{"product":{"id":7339203297477,"title":"Kenya Kaffebønner","body_html":"\u003cp\u003eSyd for Mount Kenya dyrker småbønder kaffe på de høje plateauer i Nyeri, Kirinyaga og Kiambu. De fleste bønder passer  et par hundrede træer hver. Høsten leveres til lokale kooperativer, hvor Kenyas berømte dobbeltvaskede metode fremhæver klarhed og finesse.\u003cbr\u003eResultatet er en kaffe, der indfanger Kenyas globale ry: lys, livlig syrlighed, lagdelt sød og frugtagtig kompleksitet samt en enestående kopkvalitet. Kaffen er et levende udtryk for landets berømte terroir.\u003c\/p\u003e\n\u003cp\u003eOprindelse: Massai\u003cbr\u003eHøjde: 1700 - 2200 m.a.s.l\u003cbr\u003eSorter: Arabica\u003cbr\u003eProces: vasket\u003cbr\u003eSmagsnoter: honning, mælkechokolade, tørret frugt, citron\u003c\/p\u003e","vendor":"The Brew Company","product_type":"Whole_Beans","created_at":"2022-12-15T13:42:08+02:00","handle":"kenya-special-kaffebonner","updated_at":"2026-11-12T23:36:28+02:00","published_at":"2022-12-19T18:38:43+02:00","template_suffix":"beans-kenya","published_scope":"web","tags":"YGroup_BeansKenya","variants":[{"id":41940644102341,"product_id":7339203297477,"title":"Helbønner \/ 333g","price":"129.00","sku":"A066010","position":1,"compare_at_price":"","fulfillment_service":"manual","inventory_management":"shopify","option1":"Helbønner","option2":"333g","option3":null,"created_at":"2022-12-15T13:42:08+02:00","updated_at":"2026-11-12T23:36:28+02:00","taxable":true,"barcode":"5710129701515","grams":352,"image_id":83401483288958,"weight":0.352,"weight_unit":"kg","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"DKK","compare_at_price_currency":"","quantity_price_breaks":[]}],"options":[{"id":11715476783427,"product_id":7339203297477,"name":"Muligheder for kaffekøb","position":1,"values":["Helbønner"]},{"id":9381389205701,"product_id":7339203297477,"name":"Størrelse","position":2,"values":["333g"]}],"images":[{"id":83401483288958,"product_id":7