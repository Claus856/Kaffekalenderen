{"product":{"id":7339203199173,"title":"Honduras Kaffebønner","body_html":"\u003cp\u003eKaffen er dyrket økologisk i højlandet ved Marcala af COMSAs partnerproducenter, og afspejler Café Ceiba regionens frugtbare vulkanske jord og bæredygtige, samt kemifrie dyrkningsmetoder.\u003cbr\u003eKoppen åbner med en frisk, grøn lyshed, der bløder op i brun farin-sødme. Noter af kakao og ristede mandler giver en beroligende dybde, mens et strejf af frugtagtig livlighed udgør afslutningen. Afbalanceret og samtidig levende er dette mere end bare smag, det er en bid af Marcalas jord og de kaffebønder, der tager sig af den.\u003cbr\u003e\u003cbr\u003eOprindelse: La Paz - Marcala\u003cbr\u003eCertificering: økologisk\u003cbr\u003eHøjde: 1200 - 1700 m.a.s.l.\u003cbr\u003eSorter: Ihcafe 90, Icatu, Red catuai\u003cbr\u003eProces: vasket\u003cbr\u003eSmagsnoter: vegetabilsk, brun farin, kakao, frugtagtig\u003cbr\u003e\u003c\/p\u003e","vendor":"The Brew Company","product_type":"Whole_Beans","created_at":"2022-12-15T13:41:58+02:00","handle":"honduras-special-kaffebonner","updated_at":"2026-11-12T23:45:07+02:00","published_at":"2022-12-19T18:38:41+02:00","template_suffix":"beans-honduras","published_scope":"web","tags":"YGroup_BeansHonduras","variants":[{"id":41940643840197,"product_id":7339203199173,"title":"Helbønner \/ 333g","price":"129.00","sku":"A066007","position":1,"compare_at_price":"","fulfillment_service":"manual","inventory_management":"shopify","option1":"Helbønner","option2":"333g","option3":null,"created_at":"2022-12-15T13:41:58+02:00","updated_at":"2026-11-12T23:45:07+02:00","taxable":true,"barcode":"5710129701508","grams":352,"image_id":83400824783230,"weight":0.352,"weight_unit":"kg","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"DKK","compare_at_price_currency":"","quantity_price_breaks":[]}],"options":[{"id":11715468067139,"product_id":7339203199173,"name":"Muligheder for kaffekøb","position":1,"values":["Helbønner"]},{"i